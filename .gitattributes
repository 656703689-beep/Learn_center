# Keep text files stable across Windows and macOS checkouts.
* text=auto

.gitattributes text eol=lf
.gitignore text eol=lf
*.md text eol=lf
*.html text eol=lf
*.css text eol=lf
*.json text eol=lf
*.ipynb text eol=lf
*.py text eol=lf
*.ts text eol=lf
*.sh text eol=lf

*.cmd text eol=crlf
*.ps1 text eol=crlf
